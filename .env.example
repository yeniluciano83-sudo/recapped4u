# Copy this file to .env.local and fill in real values for local dev.
# .env.local is gitignored -- never commit real credentials.

# --- Supabase (required) ---
# Service role key, not the anon key -- server-side only, bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (required for paid tiers / checkout) ---
STRIPE_SECRET_KEY=
# From the Stripe CLI or the webhook endpoint's settings in the dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Resend (required to send any email) ---
RESEND_API_KEY=

# --- Cloudflare R2 (required for photo/video storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Anthropic (required for photo scoring / roast script generation) ---
ANTHROPIC_API_KEY=

# --- App ---
# Base URL used to build absolute links in emails, QR codes, etc.
APP_URL=http://localhost:3000
# Shared password gating /dashboard (staff-only, no username). Leave unset
# to disable dashboard login entirely.
DASHBOARD_PASSWORD=
# Email address that receives booking-failure alerts from the scheduler.
ADMIN_ALERT_EMAIL=

# --- Optional: rate limiting (Upstash Redis) ---
# Without these, checkRateLimit() no-ops and every request is allowed --
# fine for local dev, not recommended for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: error monitoring (Sentry) ---
# Without this, captureError()/flushSentry() no-op.
SENTRY_DSN=

# --- Optional: video pipeline (scripts/auto-recap.js) ---
# Only needed if the system ffmpeg isn't on PATH -- see lib/video-assemble.js.
FFMPEG_PATH=
